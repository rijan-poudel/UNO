      "css": ".ds-presets{display:flex;gap:4px;padding:4px;border-radius:12px;background:#061e4c55}.ds-presets button{flex:1;min-height:44px;padding:8px;border:0;border-radius:9px;background:transparent;color:#dce9ff;font-family:var(--font-body,Outfit),sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:background-color 160ms,color 160ms}.ds-presets button[aria-pressed=\"true\"]{background:var(--club-paper,#fff7e7);color:var(--club-ink,#17345f);box-shadow:0 3px 8px #061c4540}.ds-presets button:hover:not([aria-pressed=\"true\"]){background:#ffffff14}.ds-presets button:focus-visible{outline:3px solid #ffd45a;outline-offset:4px}.ds-presets button:active{transform:scale(.97)}@media(prefers-reduced-motion:reduce){.ds-presets button{transition:none}}"
