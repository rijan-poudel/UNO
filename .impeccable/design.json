  "narrative": {
    "northStar": "The held-card table",
    "overview": "UNO feels like a hand of real cards over a quiet modern playing arena. Vivid faces, ivory stock, condensed italic numerals and a curved foreground fan carry the energy. Outfit lettering gives navigation and game information one clear voice.\n\nThe launch and settings shell retains warm, theme-aware surfaces and compact card-face player identities. Live play uses a fixed midnight palette with lime turn feedback, independent of the selected appearance. The launch illustration is a fan of the same authored deck used in play; the owner-rejected clay/Fredoka world is superseded.",
    "keyCharacteristics": [
      "One shared native card face across launch, hand, piles and motion.",
      "Outfit interface lettering paired with Barlow Condensed card numerals.",
      "Warm themed supporting surfaces and a fixed midnight live arena.",
      "A held fan with immediate inspection, upward drag and bounded scrolling.",
      "Situational controls and brief feedback that never delays a turn."
    ],
    "rules": [
      {
        "name": "The Two Surfaces Rule",
        "body": "Honor root appearance variables on supporting screens; scope the fixed midnight palette to live play. Card colors and ivory stock stay stable across both.",
        "section": "colors"
      },
      {
        "name": "The Deck Lettering Rule",
        "body": "Use Outfit for UI, headings and the card-back wordmark; reserve Barlow Condensed for indexed card faces. Preserve italic numerals and the shared face proportions when scaling.",
        "section": "typography"
      },
      {
        "name": "The Hand Owns Its Width Rule",
        "body": "Keep overflow inside the hand, preserve corner identity and focus clearance, and bound the fan arc as the card count grows.",
        "section": "layout"
      },
      {
        "name": "The Paper Lift Rule",
        "body": "A moving or inspected card changes its own depth and reveals its face. Keep unrelated chrome quiet and reserve hard stacked edges for actual piles.",
        "section": "elevation"
      },
      {
        "name": "The Play Comes First Rule",
        "body": "Motion and sound explain the current action without blocking controls, queuing stale actions or changing turn timing.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the same authored face for launch, hand, piles and card motion.",
      "Do preserve stable deck colors and the written active-color label.",
      "Do use scoped midnight arena variables while honoring appearance on supporting screens.",
      "Do retain readable six-seat phone names, visible corner indices and an independently scrolling large hand.",
      "Do make inspection, legal plays, turn state and situational actions clear with touch and keyboard.",
      "Do honor reduced motion, mute, audio readiness and interrupted gesture cleanup.",
      "Do keep presentation responsive to the current published state without delaying play."
    ],
    "donts": [
      "Don't restore clay hero art, Fredoka, a third font family or a parallel component library.",
      "Don't replace the held fan with a flat shrinking row or let large hands overflow the page.",
      "Don't add permanent UNO, duplicate Draw or permanent sorting controls to the table.",
      "Don't use Unicode glyph icons in place of the established SVG icon system.",
      "Don't give general controls hard offset block shadows; physical deck edges are the intentional exception.",
      "Don't queue narration, wait for sound or animation, or add a blocking splash."
    ]
  }
}
