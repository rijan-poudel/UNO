      "css": ".ds-field{display:grid;gap:8px;font-family:var(--font-body,Outfit),sans-serif;color:var(--ui-text,#17345f);font-size:14px;font-weight:750}.ds-field input{min-height:50px;padding:12px 15px;border:2px solid var(--ui-line,#ccd3da);border-radius:6px;background:var(--ui-surface,#fffcf4);color:var(--ui-text,#17345f);font:inherit;font-weight:400;transition:border-color 150ms}.ds-field input::placeholder{color:var(--ui-muted,#58687a)}.ds-field input:focus{border-color:var(--ui-text,#17345f)}.ds-field input:focus-visible{outline:3px solid var(--ui-accent-blue,#1254b5);outline-offset:4px}.ds-field input[aria-invalid=\"true\"]{border-color:var(--ui-accent-red,#c50730)}"
