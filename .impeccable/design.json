  "narrative": {
    "northStar": "Comic-card showdown",
    "overview": "UNO feels like a shared competitive card night, expressed through confident comic print. Almost-black ink, warm paper, vivid native card colors and condensed italic headings carry one identity across entry, setup, rooms, preferences, notifications, results and live play. Outlined controls press into their bottom edge; original expressive characters provide energy without competing with decisions.\n\nThis records the shipped whole-site identity replacement selected by the owner on October 23. The approved panel comp establishes the home composition; its illustration and oversized UNO graphic are specific to that surface. Supporting screens inherit the ink, paper, lettering and control grammar. Live play keeps a calm ink field, opaque player identities and the existing vivid native deck. The archived prior system is at `.impeccable/review/site-redesign/DESIGN.before.md`.",
    "keyCharacteristics": [
      "Warm paper against almost-black ink, with native red, yellow, green and blue as purposeful accents.",
      "Barlow Condensed italic display lettering paired with Outfit interface text.",
      "Crisp outlines, restrained corners and shallow pressed control lips.",
      "Original comic artwork with full silhouettes, real raster ink swashes and recorded provenance.",
      "A bottom-cropped held hand, nearby piles and immediate legal-card play.",
      "Real published game state, bounded reactions and sound that never delays a turn."
    ],
    "rules": [
      {
        "name": "The Paper Scope Rule",
        "body": "Home, native dialogs, toasts and live player badges retain the comic paper/ink palette. Supporting setup and room content honors the saved appearance; the native deck stays unchanged.",
        "section": "colors"
      },
      {
        "name": "The Published Color Rule",
        "body": "A selected yellow row, active badge, chosen wild color or penalty cue describes real state. Do not use color as the only label for a decision.",
        "section": "colors"
      },
      {
        "name": "The Brand Graphic Rule",
        "body": "The home UNO word is a surface-specific brand graphic, not a general display scale: tall desktop uses a 144\u2013208px clamp, shorter desktop 128px and narrow entry 112px, with outline, stretched lettering and seven-pixel desktop ink shadow. Keep those rules in the home brief; do not apply them to forms or dialogs.",
        "section": "typography"
      },
      {
        "name": "The Deck Lettering Rule",
        "body": "Preserve Barlow Condensed native face numerals, Outfit card-back lettering, italic indices and the shared card proportions. The retained native card-back wordmark is separate from the uppercase UNO brand wordmark in page chrome.",
        "section": "typography"
      },
      {
        "name": "The Hand Owns Its Width Rule",
        "body": "Bound the fan arc and keep large-hand overflow inside the hand, preserving corner identity, focus clearance and usable card size.",
        "section": "layout"
      },
      {
        "name": "The Contact Before Flight Rule",
        "body": "Settle hover tilt on contact before capturing drag or flight geometry. Preserve scale and composed rotation through pickup/return; clean up interrupted copies and retain readable static color, edge and focus when spatial motion is disabled.",
        "section": "elevation & depth"
      },
      {
        "name": "The Printed Edge Rule",
        "body": "Use a control's bottom lip to acknowledge pressing. Keep information containers flat; physical card stock and the authored title graphic retain their own depth language.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do use cream paper, black ink, native four-color accents and one shared comic control grammar across the journey.",
      "Do pair condensed italic display lettering with Outfit interface text, preserving native deck lettering.",
      "Do honor saved appearance on supporting pages while keeping native dialogs, toasts and live identity badges in their explicit paper scope.",
      "Do retain the complete original comic cast, real ink artwork and exact prompt provenance.",
      "Do preserve nearby piles, a bottom-cropped held fan, independent hand scrolling and readable six-seat phone identities.",
      "Do keep legal-card activation immediate and give touch, drag and keyboard the same current availability rules.",
      "Do retain a written chosen-color marker for wild discards and accessible routine turn/color announcements without a visible routine HUD.",
      "Do keep motion, sound, reactions and earned history tied to actual published or completed game state.",
      "Do use the native Modal, visible Close, reachable short-landscape decisions and the established SVG icon system."
    ],
    "donts": [
      "Don't restore the rejected assistant-like identity, navy title screen, side-column start actions or feature-tile grid.",
      "Don't apply the home title's stretched size or ink shadow to routine content headings.",
      "Don't restore poker felt/rails, illustrated room backgrounds, electric-blue orbit planes or decoration behind the central piles.",
      "Don't replace the held fan with a flat shrinking row, let large hands overflow the page or add portrait phone gameplay.",
      "Don't add a third font family, Unicode glyph icons, a parallel component library or idle character loops.",
      "Don't add decorative hard offset shadows to information containers; preserve native stock edges, pressed control lips and the approved title graphic.",
      "Don't add blocking splashes, queue stale sound/reactions or let presentation control turn timing.",
      "Don't infer points, finishing ranks or new rewards without completed-round evidence."
    ]
  }
}
