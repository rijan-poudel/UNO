    "arenaLayout": {
      "authority": "app/arena.css final centered-board section; components/GameBoard.tsx; lib/handLayout.ts; components/OpponentSeat.module.css; hooks/usePhonePortrait.ts",
      "contract": ".impeccable/review/quarter-hand/contract.md supersedes fully-visible-bottom guidance in .impeccable/review/responsive-table/contract.md; inherited FORM seed 2fba311c",
      "composition": {
        "stageMaxWidth": "1600px",
        "pileCenter": "min(48cqh - header height, available table height + hand headroom - half pile height - 12px); at height <=300px: 45cqh - header height",
        "hand": "Full-height lower scrollport extends below the clipped page through a measured negative bottom margin; deepest resting fan corner crops about 25% of native face height. Inner and legally raised cards expose more. Horizontal overflow only; 44px independent paging gutters."
      },
      "panelScales": [
        {
          "condition": "default",
          "hand": 1.35,
          "pile": 1.25
        },
        {
          "condition": "width >=1000px and height >=900px",
          "hand": 1.55,
          "pile": 1.5
        },
        {
          "condition": "height <=700px",
          "hand": 1.1,
          "pile": 1
        },
        {
          "condition": "height <=600px",
          "hand": 0.94,
          "pile": 0.78
        },
        {
          "condition": "width >=1000px and height 501\u2013600px",
          "hand": 1.1,
          "pile": 1.05
        },
        {
          "condition": "height <=360px",
          "hand": 0.78,
          "pile": 0.66
        },
        {
          "condition": "height <=300px",
          "hand": 0.78,
          "pile": 0.6
        }
      ],
      "overlap": {
        "source": "lib/handLayout.ts getHandOverlap; GameBoard ResizeObserver subtracts scrollport padding and ignores hidden zero-size measurements, preserving the last stable fit",
        "cardWidth": "82px * current panel hand scale",
        "minimumAdvance": "min(card width, max(44px, 40% of card width))",
        "preferredAdvance": "max(minimum advance, 65% of card width)",
        "fit": "Clamp available advance to the minimum/preferred range. Overflow scrolls without changing card size."
      },
      "handClearance": {
        "scrollportHeight": "122px * hand scale + headroom + 26px",
        "headroom": "30.5px * hand scale + 16px",
        "legalLift": "12px default; 8px at <=600px",
        "inspectionLift": "30.5px * hand scale + 8px; same for keyboard focus",
        "legalGrowth": 1.04,
        "restingStack": "Legal cards retain z-index 0; ordinary legal idle breathe removed.",
        "focusInspectionGrowth": 1,
        "focusInspectionHover": "Suppress extra hover lift and growth; reveal the complete face without vertical hand/document scrolling.",
        "crop": {
          "source": "lib/handLayout.ts getHandFan and getHandCropMargin; components/HandCard.tsx shares fan angle/drop; GameBoard measures native face offsetWidth/offsetHeight",
          "target": "Deepest resting corner loses about 25% of native face height; inner and legally raised cards expose more.",
          "pivot": "50% 120%",
          "fan": "angle = fromCenter * min(5, 12 / half); drop = 520 * (1 - cos(angle)) + edge^2 * 16",
          "fanModifiers": "depth 0.45 / rotation 0.5 by default; depth 0.2 / rotation 0.3 at height <=600px",
          "cornerExcursion": "fan drop * depth + native width / 2 * sin(abs(fan angle * rotation)) + native height * 0.2 * (1 - cos(abs(fan angle * rotation)))",
          "marginMagnitude": "max(0, round((native height * 0.25 + 26px - corner excursion) * 10) / 10)",
          "application": "Negative scrollport bottom margin; full face remains within the actual scrollport while the page clips its lower quarter.",
          "angleUnits": "Fan angles are degrees; convert to radians for sin/cos."
        }
      },
