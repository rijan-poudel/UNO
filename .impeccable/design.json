  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Vermilion form action with immediate press feedback.",
      "html": "<button class=\"ds-primary\">Deal cards</button>",
      "css": ".ds-primary{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:14px 22px;border:1px solid transparent;border-radius:14px;font-size:14px;font-weight:800;line-height:1.25;cursor:pointer;transition:background 160ms,color 160ms,transform 120ms var(--ease-out);background:var(--ui-accent-red);color:var(--ui-bg)}:host-context(:root:not([data-theme=\"midnight\"])) .ds-primary{color:#fffaf1}.ds-primary:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px;}.ds-primary:active{transform:scale(.98)}@media(hover:hover) and (pointer:fine){.ds-primary:hover{background:color-mix(in srgb,var(--ui-accent-red) 85%,var(--ui-text))}}@media(prefers-reduced-motion:reduce){.ds-primary{transition-duration:.01ms}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined supporting action.",
      "html": "<button class=\"ds-secondary\">Done</button>",
      "css": ".ds-secondary{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:14px 22px;border:1px solid transparent;border-radius:14px;font-size:14px;font-weight:800;line-height:1.25;cursor:pointer;transition:background 160ms,color 160ms,transform 120ms var(--ease-out);background:transparent;color:var(--ui-text);border-color:var(--ui-line)}.ds-secondary:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px;}.ds-secondary:active{transform:scale(.98)}@media(hover:hover) and (pointer:fine){.ds-secondary:hover{background:color-mix(in srgb,var(--ui-text) 5%,transparent)}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition-duration:.01ms}}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet inline action.",
      "html": "<button class=\"ds-text\">Back to home</button>",
      "css": ".ds-text{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:4px 0;border:0;background:transparent;color:var(--ui-text);font-size:13px;font-weight:500;text-underline-offset:4px;cursor:pointer}.ds-text:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px;}@media(hover:hover) and (pointer:fine){.ds-text:hover{text-decoration:underline}}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Compact named utility control.",
      "html": "<button class=\"ds-icon\" aria-label=\"Sound settings\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"/><path d=\"M16 9a5 5 0 0 1 0 6M19.364 18.364a9 9 0 0 0 0-12.728\"/></svg></button>",
      "css": ".ds-icon{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border:0;border-radius:10px;background:transparent;color:var(--ui-text);cursor:pointer;transition:background 160ms,transform 120ms}.ds-icon:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px;}.ds-icon:active{transform:scale(.98)}@media(hover:hover) and (pointer:fine){.ds-icon:hover{background:color-mix(in srgb,var(--ui-text) 7%,transparent)}}@media(prefers-reduced-motion:reduce){.ds-icon{transition-duration:.01ms}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "field",
      "description": "Native labeled field on light paper.",
      "html": "<label class=\"ds-field-label\" for=\"ds-name\">Your name</label><input class=\"ds-field\" id=\"ds-name\" placeholder=\"You\" />",
      "css": ".ds-field-label{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;display:block;color:var(--ui-text);font-size:13px;font-weight:600;margin-bottom:8px}.ds-field{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;box-sizing:border-box;width:100%;min-width:0;height:50px;padding:12px 15px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);color:var(--ui-text);font-size:15px;caret-color:var(--ui-accent-red);transition:border-color 150ms}.ds-field::placeholder{color:var(--ui-muted);opacity:1}.ds-field:focus{border-color:var(--ui-text)}.ds-field:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-field{transition-duration:.01ms}}"
    },
    {
      "name": "Play choice",
      "kind": "button",
      "refersTo": "play-choice-primary",
      "description": "Principal two-line invitation to play.",
      "html": "<button class=\"ds-choice\"><span><strong>Play with bots</strong><small>Jump straight in</small></span><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-choice{font-family:var(--font-body,\"Nunito Sans\"),sans-serif;display:flex;align-items:center;justify-content:space-between;text-align:left;gap:15px;padding:14px 19px 14px 14px;border:2px solid #2c2c32;border-radius:21px;background:#f1c95b;color:#2c2c32;box-shadow:0 6px 14px #2c2c3228;cursor:pointer;transition:background 160ms,transform 160ms}.ds-choice strong{display:block;font-family:var(--font-display,\"Fredoka\"),sans-serif;font-size:23px;font-weight:550}.ds-choice small{display:block;margin-top:4px;color:#655425;font-size:13px;font-weight:700}.ds-choice:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px}.ds-choice:active{transform:translateY(3px) scale(.985);box-shadow:none}@media(hover:hover){.ds-choice:hover{background:#f7d775;transform:translateY(-3px)}}@media(prefers-reduced-motion:reduce){.ds-choice{transition:none}.ds-choice:hover,.ds-choice:active{transform:none}}"
    },
    {
      "name": "Settings tabs",
      "kind": "nav",
      "refersTo": "button-text",
      "description": "Three equal tabs with a fine baseline and red selection.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Settings\"><button aria-current=\"page\">Profile</button><button>Rules</button><button>Audio</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Look</button></nav>",
      "css": ".ds-tabs{display:flex;border-bottom:1px solid var(--ui-line);gap:12px}.ds-tabs button{font-family:var(--font-body, \"Nunito Sans\"),sans-serif;flex:1;border:0;border-bottom:2px solid transparent;background:transparent;padding:13px 3px;color:var(--ui-muted);font-size:13px;cursor:pointer}.ds-tabs button[aria-current=\"page\"]{color:var(--ui-text);border-bottom-color:var(--ui-accent-red);font-weight:600}.ds-tabs button:focus-visible{outline:3px solid var(--ui-accent-blue);outline-offset:4px;}"
    },
    {
      "name": "UNO card",
      "kind": "custom",
      "refersTo": "uno-card",
      "description": "The physical face shared by hand, piles, and showcase.",
      "html": "<div class=\"ds-card\" role=\"img\" aria-label=\"Red nine\"><span class=\"ds-index ds-top\">9</span><span class=\"ds-orbit\"></span><span class=\"ds-value\">9</span><span class=\"ds-index ds-bottom\">9</span></div>",
      "css": ".ds-card{box-sizing:border-box;position:relative;display:inline-block;width:82px;height:122px;overflow:hidden;border:4px solid #fcf6e7;border-radius:9px;background:#bd4430;color:#fcf6e7;font-family:var(--font-display,\"Fredoka\"),sans-serif;box-shadow:0 3px 5px #071b2526;user-select:none}.ds-index{position:absolute;z-index:2;width:28px;height:24px;display:grid;place-items:center;font-size:16px;font-weight:700;line-height:1}.ds-top{top:5px;left:0}.ds-bottom{bottom:5px;right:0;transform:rotate(180deg)}.ds-orbit{position:absolute;box-sizing:border-box;width:82%;height:68%;left:9%;top:16%;border:1.5px solid currentColor;border-radius:50%;transform:rotate(24deg);opacity:.7}.ds-value{position:absolute;inset:15% 0;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:700;letter-spacing:-.04em;line-height:1}"
    },
    {
      "name": "Player character",
      "kind": "custom",
      "refersTo": "player-character",
      "description": "Small physical card identity shared by setup and the playing table.",
      "html": "<span class=\"ds-character\" aria-hidden=\"true\"><span class=\"ds-eyes\"><i></i><i></i></span><span class=\"ds-smile\"></span></span>",
      "css": ".ds-character{position:relative;display:inline-flex;width:33px;height:41px;background:#ef755d;border:2px solid #323139;border-radius:8px;box-shadow:1px 3px 6px #32313938;transform:rotate(-8deg)}.ds-eyes{position:absolute;top:33%;left:22%;right:22%;display:flex;justify-content:space-between}.ds-eyes i{width:4px;height:6px;border-radius:50%;background:#323139}.ds-smile{position:absolute;left:35%;top:56%;width:10px;height:6px;border:2px solid #323139;border-top:0;border-radius:0 0 10px 10px}"
    },
    {
      "name": "Local turn badge",
      "kind": "chip",
      "refersTo": "local-turn-badge",
      "description": "Truthful active-turn status on the table.",
      "html": "<span class=\"ds-turn\">Your turn</span>",
      "css": ".ds-turn{font-family:var(--font-body,\"Nunito Sans\"),sans-serif;display:inline-flex;align-items:center;gap:7px;border-radius:8px;padding:5px 13px;background:#e8bd4e;color:#30372c;font-size:11px}"
    }
  ],
  "narrative": {
    "northStar": "The card playground",
