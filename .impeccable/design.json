  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Warm amber action with a shallow pressed lip.",
      "html": "<button class=\"ds-primary\">Start round</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:14px 22px;border:0;border-radius:12px;background:var(--club-yellow,#ffd45a);color:var(--club-ink,#17345f);font-family:var(--font-body,Outfit),sans-serif;font-size:14px;font-weight:750;line-height:1.25;box-shadow:inset 0 -3px 0 #bf8a28,0 4px 10px #061e4c20;cursor:pointer;transition:transform 140ms cubic-bezier(.16,1,.3,1),background-color 140ms ease}.ds-primary:hover:not(:disabled){background:#ffdc36}.ds-primary:active:not(:disabled){transform:scale(.97);box-shadow:inset 0 -1px 0 #17345f35}.ds-primary:disabled{opacity:.5;box-shadow:none}.ds-primary:focus-visible{outline:3px solid var(--ui-accent-blue,#1254b5);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Theme-aware outlined secondary action.",
      "html": "<button class=\"ds-secondary\">Create a room</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:14px 22px;border:1px solid var(--ui-line,#ccd3da);border-radius:12px;background:transparent;color:var(--ui-text,#17345f);font-family:var(--font-body,Outfit),sans-serif;font-size:14px;font-weight:750;line-height:1.25;cursor:pointer;transition:transform 140ms cubic-bezier(.16,1,.3,1),background-color 140ms ease}.ds-secondary:hover{background:#ffd45a20}.ds-secondary:active{transform:scale(.97)}.ds-secondary:focus-visible{outline:3px solid var(--ui-accent-blue,#1254b5);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:active{transform:none}}"
    },
    {
      "name": "Home Play",
      "kind": "button",
      "refersTo": "launch-primary",
