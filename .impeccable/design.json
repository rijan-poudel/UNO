  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Theme-aware supporting action.",
      "html": "<button class=\"ds-primary\">Deal cards</button>",
      "css": ".ds-primary{font-family:var(--font-body,Outfit),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:14px 22px;border:1px solid transparent;border-radius:14px;font-size:14px;font-weight:800;line-height:1.25;cursor:pointer;transition:background 160ms,color 160ms,transform 120ms var(--ease-out,cubic-bezier(.2,.8,.2,1));background:var(--ui-accent-red,#c74531);color:var(--ui-bg,#fff8ec);box-shadow:0 4px 10px color-mix(in srgb,var(--ui-accent-red,#c74531) 25%,transparent);}.ds-primary:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}.ds-primary:active{transform:translateY(3px) scale(.985);box-shadow:none}@media(hover:hover){.ds-primary:hover{background:color-mix(in srgb,var(--ui-accent-red,#c74531) 85%,var(--ui-text,#2c2c32));}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}:host-context(:root:not([data-theme=\"midnight\"])) .ds-primary{color:#fffaf1}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Theme-aware supporting action.",
      "html": "<button class=\"ds-secondary\">Done</button>",
      "css": ".ds-secondary{font-family:var(--font-body,Outfit),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:14px 22px;border:1px solid transparent;border-radius:14px;font-size:14px;font-weight:800;line-height:1.25;cursor:pointer;transition:background 160ms,color 160ms,transform 120ms var(--ease-out,cubic-bezier(.2,.8,.2,1));background:transparent;color:var(--ui-text,#2c2c32);border-color:var(--ui-line,#e3dbce);}.ds-secondary:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}.ds-secondary:active{transform:translateY(3px) scale(.985);box-shadow:none}@media(hover:hover){.ds-secondary:hover{background:color-mix(in srgb,var(--ui-text,#2c2c32) 5%,transparent);}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:active{transform:none}}"
    },
    {
      "name": "Text button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet inline action.",
      "html": "<button class=\"ds-text\">Back to home</button>",
      "css": ".ds-text{font-family:var(--font-body,Outfit),sans-serif;display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:4px 0;border:0;background:transparent;color:var(--ui-text,#2c2c32);font-size:13px;font-weight:500;text-underline-offset:4px;cursor:pointer}.ds-text:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}@media(hover:hover){.ds-text:hover{text-decoration:underline}}.ds-text:active{opacity:.8}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Named compact utility.",
      "html": "<button class=\"ds-icon\" aria-label=\"Game menu\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button>",
      "css": ".ds-icon{font-family:var(--font-body,Outfit),sans-serif;display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border:0;border-radius:10px;background:transparent;color:var(--ui-text,#2c2c32);cursor:pointer;transition:background 160ms,transform 120ms}.ds-icon:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}.ds-icon:active{transform:scale(.98)}@media(hover:hover){.ds-icon:hover{background:color-mix(in srgb,var(--ui-text,#2c2c32) 7%,transparent)}}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}.ds-icon:active{transform:none}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "field",
      "description": "Native labeled supporting field.",
      "html": "<label class=\"ds-label\" for=\"ds-player-name\">Your name</label><input class=\"ds-field\" id=\"ds-player-name\" placeholder=\"You\"/>",
      "css": ".ds-label{font-family:var(--font-body,Outfit),sans-serif;display:block;margin-bottom:8px;color:var(--ui-text,#2c2c32);font-size:13px;font-weight:600}.ds-field{font-family:var(--font-body,Outfit),sans-serif;box-sizing:border-box;width:100%;height:50px;padding:12px 15px;border:1px solid var(--ui-line,#e3dbce);border-radius:10px;background:var(--ui-surface,#fffcf5);color:var(--ui-text,#2c2c32);font-size:15px;caret-color:var(--ui-accent-red,#c74531);transition:border-color 150ms}.ds-field::placeholder{color:var(--ui-muted,#706b65);opacity:1}.ds-field:focus{border-color:var(--ui-text,#2c2c32)}.ds-field:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}"
    },
    {
      "name": "Settings tabs",
      "kind": "nav",
      "refersTo": "button-text",
      "description": "Equal text tabs with selected underline.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Settings\"><button role=\"tab\" aria-selected=\"true\">Profile</button><button role=\"tab\" aria-selected=\"false\">Rules</button><button role=\"tab\" aria-selected=\"false\">Audio</button><button role=\"tab\" aria-selected=\"false\">Look</button></div>",
      "css": ".ds-tabs{display:flex;border-bottom:1px solid var(--ui-line,#e3dbce);gap:12px}.ds-tabs button{font-family:var(--font-body,Outfit),sans-serif;flex:1;border:0;border-bottom:2px solid transparent;background:transparent;padding:13px 3px;color:var(--ui-muted,#706b65);font-size:13px;cursor:pointer}.ds-tabs button[aria-selected=\"true\"]{color:var(--ui-text,#2c2c32);border-bottom-color:var(--ui-accent-red,#c74531);font-weight:600}.ds-tabs button:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}.ds-tabs button:hover{color:var(--ui-text,#2c2c32)}.ds-tabs button:active{opacity:.8}"
    },
    {
      "name": "Play choice",
      "kind": "button",
      "refersTo": "play-choice-primary",
      "description": "Two-line launch invitation.",
      "html": "<button class=\"ds-choice\"><span><strong>Play with bots</strong><small>Jump straight in</small></span><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-choice{font-family:var(--font-body,Outfit),sans-serif;display:flex;align-items:center;justify-content:space-between;gap:15px;text-align:left;min-height:94px;padding:14px 19px 14px 14px;border:2px solid #2c2c32;border-radius:21px;background:#f1c95b;color:#2c2c32;box-shadow:0 6px 14px #2c2c3228;cursor:pointer;transition:background 160ms,transform 160ms}.ds-choice strong{display:block;font-size:23px;font-weight:550;line-height:1.2}.ds-choice small{display:block;margin-top:4px;color:#655425;font-size:13px;font-weight:700}.ds-choice:focus-visible{outline:3px solid var(--ui-accent-blue,#3265a0);outline-offset:4px}.ds-choice:active{transform:translateY(3px) scale(.985);box-shadow:none}@media(hover:hover){.ds-choice:hover{background:#f7d775;transform:translateY(-3px) rotate(-.4deg)}}@media(prefers-reduced-motion:reduce){.ds-choice{transition:none}.ds-choice:hover,.ds-choice:active{transform:none}}"
    },
    {
      "name": "Active opponent badge",
      "kind": "chip",
      "refersTo": "opponent-badge-active",
      "description": "Truthful active-seat state on midnight.",
      "html": "<span class=\"ds-seat\"><span><strong>Alex</strong><small>4 cards</small></span><i aria-hidden=\"true\"></i></span>",
      "css": ".ds-seat{font-family:var(--font-body,Outfit),sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:7px 10px;max-width:140px;border-radius:12px;background:#d8ed82;color:#172130}.ds-seat strong{display:block;font-size:12px;font-weight:500}.ds-seat small{display:block;font-size:11px;color:#3f5023}.ds-seat i{width:5px;height:5px;border-radius:50%;background:#3f5023}"
    },
    {
      "name": "UNO card",
      "kind": "card",
      "refersTo": "uno-card",
      "description": "Native vivid face shared by hand, piles and launch.",
      "html": "<div class=\"ds-card\" role=\"img\" aria-label=\"Red nine\"><span class=\"ds-index ds-top\">9</span><span class=\"ds-orbit\"></span><span class=\"ds-value\">9</span><span class=\"ds-index ds-bottom\">9</span></div>",
      "css": ".ds-card{box-sizing:border-box;position:relative;isolation:isolate;display:inline-block;width:82px;height:122px;overflow:hidden;border:3px solid #fffdf5;border-radius:9px;background:#e73442;color:#fffdf5;font-family:var(--font-card,\"Barlow Condensed\"),sans-serif;box-shadow:0 5px 10px #070c1659;user-select:none}.ds-orbit{position:absolute;width:86%;height:73%;left:7%;top:14%;background:#fffdf5;border-radius:50%;transform:rotate(30deg)}.ds-index{position:absolute;z-index:2;display:grid;place-items:center;min-width:19px;height:22px;font-size:19px;font-weight:800;font-style:italic;line-height:1}.ds-top{top:3px;left:3px}.ds-bottom{bottom:3px;right:3px;transform:rotate(180deg)}.ds-value{position:absolute;inset:16% 0;display:flex;align-items:center;justify-content:center;color:#e73442;font-size:70px;font-weight:800;font-style:italic;letter-spacing:-.03em;line-height:1;transform:rotate(-10deg)}"
