      "css": ".ds-play{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:70px;padding:12px 22px;border:0;border-radius:14px;background:var(--club-yellow,#ffd45a);color:#38290c;box-shadow:inset 0 -4px 0 #bf8a28,0 8px 18px #061e4c45;text-align:left;font-family:var(--font-body,Outfit),sans-serif;font-size:24px;font-weight:750;line-height:1.25;cursor:pointer;transition:transform 140ms cubic-bezier(.16,1,.3,1),background-color 140ms ease}.ds-play small{display:block;margin-top:1px;font-size:13px;font-weight:500;color:#5a410f}.ds-play:hover{background:#ffdc36}.ds-play:active{transform:scale(.97)}.ds-play:focus-visible{outline:3px solid #ffd45a;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-play{transition:none}.ds-play:active{transform:none}}"
