a": {"boundsAnyNonzero": [29, 38, 1836, 846], "boundsAbove1of255": [98, 63, 1713, 779], "boundsAbove128of255": [101, 66, 1711, 775], "extrema": [0, 255], "note": "Generator includes very faint alpha=1 noise beyond the visible silhouette, including the final row. Full visible artwork has clear margin; original alpha is preserved."}, "qa_status": "accepted", "qa_notes": "Compared generated source and final WebP with approved panel: comic ink, flat saturated cel shading, specified cast/hoodies, complete ears/heads/hands/table, native UNO backs and no UI/page chrome. No clay styling. Original artwork retained.", "deviations": ["1860\u00d7846 instead of requested aspirational 2200\u00d71000; exceeds assigned minimum width 1600 and matches target aspect ratio.", "Faint alpha=1 generator noise extends past visible margin; no visible crop."]}</impeccable:provenance></rdf:Description></rdf:RDF></x:xmpmeta><?xpacket end="w"?>