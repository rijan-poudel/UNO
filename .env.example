# Local development resolves the Socket.IO server on port 3001 automatically.
# Set this to your persistent socket host when deploying the frontend.
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-service.example.com

# Socket host configuration (export these in the host environment):
# PORT=3001
# UNO_CORS_ORIGINS=https://your-app.example.com
# Durable accepted friends and pending requests for the socket server.
# Set to a path on a persistent volume in production (one socket process).
# UNO_SOCIAL_FILE=/var/lib/uno/friends.json
