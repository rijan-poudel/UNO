{
  "name": "uno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agent": "tsx agent/agent.ts",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:socket\"",
    "dev:web": "next dev --webpack",
    "dev:socket": "tsx watch --include \"lib/**/*.ts\" --include \"types/**/*.ts\" server/socketServer.ts",
    "start:socket": "tsx server/socketServer.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:types": "tsc --noEmit",
    "check:game": "tsx scripts/check-game.ts",
    "check:multiplayer": "tsx scripts/check-card-network.ts && tsx scripts/check-multiplayer.ts && tsx scripts/check-turn-network.ts && tsx scripts/check-private-network.ts && tsx scripts/check-friends-network.ts && tsx scripts/check-edition-network.ts",
    "audio:prepare": "node scripts/prepare-audio.mjs",
    "format": "prettier --write app components hooks lib server scripts types docs .github *.json *.ts *.mjs *.md",
    "format:check": "prettier --check app components hooks lib server scripts types docs .github *.json *.ts *.mjs *.md",
    "check:audio": "tsx scripts/check-audio.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
